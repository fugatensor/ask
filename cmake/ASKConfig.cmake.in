@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if("Core" IN_LIST ASK_FIND_COMPONENTS)
  find_dependency(LLVM @ASK_LLVM_CMAKE_VERSION@ EXACT CONFIG)
  find_dependency(MLIR @ASK_LLVM_CMAKE_VERSION@ EXACT CONFIG)
  if(NOT MLIR_INSTALL_PREFIX STREQUAL LLVM_INSTALL_PREFIX)
    set(ASK_FOUND FALSE)
    set(ASK_NOT_FOUND_MESSAGE "ASK::Core requires LLVM/MLIR @ASK_LLVM_CMAKE_VERSION@ from one SDK installation")
    return()
  endif()
  include("${CMAKE_CURRENT_LIST_DIR}/ASKCoreTargets.cmake")
  target_include_directories(ASK::Core SYSTEM INTERFACE ${LLVM_INCLUDE_DIRS} ${MLIR_INCLUDE_DIRS})
  set(ASK_Core_FOUND TRUE)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ASKCompilerTargets.cmake")
set(ASK_Compiler_FOUND TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/ASKRuntimeTargets.cmake")
set(ASK_Runtime_FOUND TRUE)
foreach(component IN LISTS ASK_FIND_COMPONENTS)
  if(NOT component STREQUAL "Core" AND NOT component STREQUAL "Compiler" AND NOT component STREQUAL "Runtime")
    set(ASK_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(ASK)
