@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(LLVM @ASK_LLVM_CMAKE_VERSION@ EXACT CONFIG)
find_dependency(MLIR @ASK_LLVM_CMAKE_VERSION@ EXACT CONFIG)
file(READ "${LLVM_INCLUDE_DIR}/llvm/Support/VCSRevision.h" _ask_llvm_revision_header)
string(FIND "${_ask_llvm_revision_header}" "@ASK_LLVM_REVISION@" _ask_revision_match)
if(_ask_revision_match EQUAL -1 OR NOT MLIR_INSTALL_PREFIX STREQUAL LLVM_INSTALL_PREFIX)
  set(ASK_FOUND FALSE)
  set(ASK_NOT_FOUND_MESSAGE "ASK requires the pinned LLVM/MLIR SDK in share/ask/llvm.lock.json")
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ASKCoreTargets.cmake")
target_include_directories(ASK::Core SYSTEM INTERFACE ${LLVM_INCLUDE_DIRS} ${MLIR_INCLUDE_DIRS})
set(ASK_Core_FOUND TRUE)
foreach(component IN LISTS ASK_FIND_COMPONENTS)
  if(NOT component STREQUAL "Core")
    set(ASK_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(ASK)
