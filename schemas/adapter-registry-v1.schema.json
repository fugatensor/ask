{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASK compiler adapter registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compilers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "compilers": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
