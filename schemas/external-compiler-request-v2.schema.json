{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASK external compiler worker request v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "source",
    "entry",
    "signature",
    "source_bindings",
    "constants",
    "fixed_options",
    "target",
    "grid",
    "port_shapes"
  ],
  "properties": {
    "protocol_version": {
      "const": 2
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "signature": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "*i1",
          "*i32",
          "*i64",
          "*fp32",
          "*fp16",
          "*bf16",
          "i1",
          "i8",
          "i16",
          "i32",
          "i64",
          "u8",
          "u16",
          "u32",
          "u64",
          "fp16",
          "bf16",
          "fp32",
          "fp64"
        ]
      }
    },
    "source_bindings": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^(input|output):(0|[1-9][0-9]*)$"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "constants": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "fixed_options": {
      "type": "object",
      "description": "Compiler-specific compile options, interpreted only by the caller-owned worker.",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "arch"
      ],
      "properties": {
        "backend": {
          "const": "cuda"
        },
        "arch": {
          "type": "integer",
          "minimum": 10,
          "maximum": 999
        },
        "warp_size": {
          "const": 32
        }
      }
    },
    "grid": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    },
    "port_shapes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "string"
          ]
        },
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 18446744073709551615
        },
        {
          "type": "number",
          "not": {
            "type": "integer"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
