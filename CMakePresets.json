{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 0},
  "configurePresets": [
    {"name": "base", "hidden": true, "generator": "Ninja", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON", "ASK_TARGET_BACKENDS": "host"}},
    {"name": "core", "inherits": "base", "binaryDir": "${sourceDir}/build/core"}
  ],
  "buildPresets": [
    {"name": "core", "configurePreset": "core"}
  ],
  "testPresets": [
    {"name": "core", "configurePreset": "core", "output": {"outputOnFailure": true}}
  ]
}
