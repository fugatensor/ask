{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASK external kernel artifact v1",
  "type": "object",
  "required": [
    "protocol_version",
    "format",
    "entry",
    "payload",
    "producer",
    "target",
    "port_map",
    "invocation",
    "dependencies",
    "validation",
    "required_element_types",
    "specializations",
    "codegen"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "format": {
      "const": "llvm-ir"
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "payload": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": [
        "backend",
        "arch",
        "warp_size"
      ],
      "properties": {
        "backend": {
          "const": "cuda"
        },
        "arch": {
          "type": "integer",
          "minimum": 70,
          "maximum": 999
        },
        "warp_size": {
          "const": 32
        },
        "data_layout": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "port_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_parameter",
          "logical_port",
          "argument",
          "element_type",
          "storage_bytes",
          "shape",
          "layout"
        ],
        "properties": {
          "source_parameter": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "logical_port": {
            "type": "string",
            "pattern": "^(input|output):(0|[1-9][0-9]*)$"
          },
          "argument": {
            "type": "integer",
            "minimum": 0
          },
          "element_type": {
            "enum": [
              "bool",
              "i32",
              "i64",
              "f32",
              "f16",
              "bf16"
            ]
          },
          "storage_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "shape": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "layout": {
            "const": "contiguous_row_major"
          }
        },
        "additionalProperties": true
      }
    },
    "invocation": {
      "type": "object",
      "required": [
        "version",
        "kind",
        "grid",
        "block",
        "shared_bytes",
        "arguments",
        "completion"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "kind": {
          "const": "cuda-kernel"
        },
        "grid": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "block": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "shared_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "argument",
              "binding",
              "llvm_type"
            ],
            "properties": {
              "argument": {
                "type": "integer",
                "minimum": 0
              },
              "binding": {
                "type": "string",
                "minLength": 1
              },
              "llvm_type": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "completion": {
          "const": "device-event"
        }
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "llvm_module_verified",
        "device_execution_performed",
        "stage"
      ],
      "properties": {
        "llvm_module_verified": {
          "type": "boolean"
        },
        "device_execution_performed": {
          "const": false
        },
        "stage": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "required_element_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "bool",
          "i32",
          "i64",
          "f32",
          "f16",
          "bf16"
        ]
      }
    },
    "specializations": {
      "type": "object",
      "required": [
        "constants",
        "fixed_options",
        "source_bindings",
        "source_sha256"
      ],
      "properties": {
        "constants": {
          "type": "object"
        },
        "fixed_options": {
          "type": "object"
        },
        "source_bindings": {
          "type": "object"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "port_shapes": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "codegen": {
      "type": "object",
      "required": [
        "fp_contract",
        "ptx_version"
      ],
      "properties": {
        "fp_contract": {
          "enum": [
            "on",
            "off",
            "fast"
          ]
        },
        "ptx_version": {
          "type": "integer",
          "minimum": 10,
          "maximum": 999
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
