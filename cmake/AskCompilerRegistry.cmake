# The catalog is explicit. A stray directory or installed Python package never
# enables a compiler, and an unselected adapter's CMake is not evaluated.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${PROJECT_SOURCE_DIR}/adapters/registry.json")
file(READ "${PROJECT_SOURCE_DIR}/adapters/registry.json" ASK_COMPILER_CATALOG)
string(JSON ASK_CATALOG_VERSION GET "${ASK_COMPILER_CATALOG}" schema_version)
if(NOT ASK_CATALOG_VERSION EQUAL 1)
  message(FATAL_ERROR "Unsupported ASK compiler catalog schema")
endif()
string(JSON ASK_COMPILER_COUNT LENGTH "${ASK_COMPILER_CATALOG}" compilers)
set(ASK_SUPPORTED_COMPILERS "")
if(ASK_COMPILER_COUNT GREATER 0)
  math(EXPR ASK_COMPILER_LAST "${ASK_COMPILER_COUNT} - 1")
  foreach(index RANGE ${ASK_COMPILER_LAST})
    string(JSON id MEMBER "${ASK_COMPILER_CATALOG}" compilers ${index})
    string(JSON directory GET "${ASK_COMPILER_CATALOG}" compilers "${id}")
    if(NOT id MATCHES "^[a-z][a-z0-9_]*$" OR
       NOT directory MATCHES "^[a-z][a-z0-9_]*$")
      message(FATAL_ERROR "Compiler IDs and directories must be simple lowercase names")
    endif()
    list(APPEND ASK_SUPPORTED_COMPILERS "${id}")
    set(ASK_COMPILER_DIRECTORY_${id} "${PROJECT_SOURCE_DIR}/adapters/${directory}")
  endforeach()
endif()
list(SORT ASK_SUPPORTED_COMPILERS)

function(ask_configure_compilers)
  set(manifest "// Generated from the explicit selected compiler catalog.\n")
  set(python_registry "{}")
  set(adapter_objects "")
  foreach(id IN LISTS ASK_ENABLED_COMPILERS)
    set(directory "${ASK_COMPILER_DIRECTORY_${id}}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${directory}/registration.json")
    file(READ "${directory}/registration.json" registration)
    string(JSON declared_id GET "${registration}" id)
    string(JSON factory GET "${registration}" native_factory)
    string(JSON fusion GET "${registration}" supports_fusion)
    string(JSON protocol GET "${registration}" protocol_version)
    if(NOT declared_id STREQUAL id OR NOT factory MATCHES "^[A-Za-z_][A-Za-z0-9_]*$"
       OR NOT protocol EQUAL 1)
      message(FATAL_ERROR "Invalid registration in ${directory}")
    endif()
    if(fusion)
      set(fusion_literal true)
    else()
      set(fusion_literal false)
    endif()
    string(APPEND manifest "ASK_COMPILER_ADAPTER(\"${id}\", ${factory}, ${fusion_literal})\n")
    string(JSON python_registry SET "${python_registry}" "${id}" "${registration}")

    # Dependency probes, producer C++ files, tests and resource installation all
    # belong to the selected directory. No producer name is dispatched here.
    add_subdirectory("${directory}" "${PROJECT_BINARY_DIR}/adapters/${id}")
    if(NOT TARGET ask_adapter_${id})
      message(FATAL_ERROR "${id} did not define its ask_adapter_${id} object target")
    endif()
    list(APPEND adapter_objects "$<TARGET_OBJECTS:ask_adapter_${id}>")
    set(package "${PROJECT_BINARY_DIR}/python/ask/_adapters/${id}")
    file(MAKE_DIRECTORY "${package}")
    file(GLOB_RECURSE adapter_python CONFIGURE_DEPENDS "${directory}/python/*.py")
    foreach(source IN LISTS adapter_python)
      file(RELATIVE_PATH relative "${directory}/python" "${source}")
      configure_file("${source}" "${package}/${relative}" COPYONLY)
    endforeach()
    install(DIRECTORY "${directory}/python/" DESTINATION "${ASK_PYTHON_INSTALL_DIR}/_adapters/${id}"
      COMPONENT Core FILES_MATCHING PATTERN "*.py")
  endforeach()
  file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/generated/ask/Adapters")
  file(WRITE "${PROJECT_BINARY_DIR}/generated/ask/Adapters/Manifest.inc" "${manifest}")
  file(WRITE "${PROJECT_BINARY_DIR}/python/ask/_adapter_registry.json" "${python_registry}\n")
  install(FILES "${PROJECT_BINARY_DIR}/python/ask/_adapter_registry.json"
    DESTINATION "${ASK_PYTHON_INSTALL_DIR}" COMPONENT Core)
  set(ASK_ADAPTER_OBJECTS "${adapter_objects}" PARENT_SCOPE)
endfunction()
