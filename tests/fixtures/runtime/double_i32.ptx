.version 8.0
.target sm_80
.address_size 64
.visible .entry double_i32(.param .u64 src, .param .u64 dst) {
  .reg .pred %p;
  .reg .b32 %i, %v;
  .reg .b64 %x, %y, %offset;
  mov.u32 %i, %tid.x;
  setp.ge.u32 %p, %i, 4;
  @%p bra done;
  ld.param.u64 %x, [src];
  ld.param.u64 %y, [dst];
  mul.wide.u32 %offset, %i, 4;
  add.u64 %x, %x, %offset;
  add.u64 %y, %y, %offset;
  ld.global.u32 %v, [%x];
  add.u32 %v, %v, %v;
  st.global.u32 [%y], %v;
done:
  ret;
}
