{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASK external worker executable artifact v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 2
    },
    "format": {
      "enum": [
        "cubin",
        "ptx"
      ]
    },
    "payload": {
      "type": "string",
      "minLength": 1,
      "description": "Base64 cubin bytes, or PTX source text without embedded NULs."
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "arch"
      ],
      "properties": {
        "backend": {
          "const": "cuda"
        },
        "arch": {
          "type": "integer",
          "minimum": 10,
          "maximum": 999
        },
        "warp_size": {
          "const": 32
        }
      }
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid",
        "block",
        "shared_bytes"
      ],
      "properties": {
        "grid": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "block": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "shared_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^(null|(input|output):(0|[1-9][0-9]*))$"
      }
    },
    "required_element_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "bool",
          "i32",
          "i64",
          "f32",
          "f16",
          "bf16"
        ]
      }
    }
  },
  "required": [
    "protocol_version",
    "format",
    "payload",
    "entry",
    "target",
    "producer",
    "launch",
    "arguments",
    "required_element_types"
  ]
}
